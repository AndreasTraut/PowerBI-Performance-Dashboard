	measure 'Sales YoY Arrow' =
			
			VAR SalesCY =
			    [curr_year_sales]      -- your current year measure
			
			VAR SalesPY =
			    [prev_year_sales]      -- your previous year measure
			
			VAR Change =
			    DIVIDE( SalesCY - SalesPY, SalesPY )
			
			RETURN
			IF(
			    ISBLANK(Change),
			    BLANK(),
			    IF( Change > 0, "▲", "▼" )
			)
		lineageTag: 92f0dfe9-4a15-4d83-9956-231a6c315290

	measure 'Sales YoY Change Numeric' =
			
			VAR SalesCY = [curr_year_sales]      -- current year sales
			VAR SalesPY = [prev_year_sales]      -- previous year sales
			RETURN
			DIVIDE(SalesCY - SalesPY, SalesPY)
		lineageTag: b2626db3-f8dd-471f-801d-8f8f3d975f28

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales YoY Change Text' = ```
			
			VAR SalesCY = [curr_year_sales]      -- current year sales
			VAR SalesPY = [prev_year_sales]      -- previous year sales
			VAR Change = DIVIDE(SalesCY - SalesPY, SalesPY)
			VAR Sign = 
			    IF(Change >= 0, "+", "-")
			RETURN
