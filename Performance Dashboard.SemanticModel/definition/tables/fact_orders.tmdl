	measure Returning_Customers_MoM_Diff =
			VAR CurrCust = VALUES( 'fact_orders'[CustomerID] )
			VAR Prev1_Cust =
			    CALCULATETABLE(
			        VALUES( 'fact_orders'[CustomerID] ),
			        DATEADD( 'dim_date'[Date], -1, YEAR )
			    )
			VAR Prev2_Cust =
			    CALCULATETABLE(
			        VALUES( 'fact_orders'[CustomerID] ),
			        DATEADD( 'dim_date'[Date], -2, YEAR )
			    )
			VAR ReturningCurr =
			    COUNTROWS(
			        INTERSECT(
			            Prev2_Cust,
			            EXCEPT( CurrCust, Prev1_Cust )
			        )
			    )
			
			VAR PY_CurrCust =
			    CALCULATETABLE(
			        VALUES( 'fact_orders'[CustomerID] ),
			        SAMEPERIODLASTYEAR( 'dim_date'[Date] )
			    )
			VAR PY_Prev1_Cust =
			    CALCULATETABLE(
			        VALUES( 'fact_orders'[CustomerID] ),
			        DATEADD( SAMEPERIODLASTYEAR( 'dim_date'[Date] ), -1, YEAR )
			    )
			VAR PY_Prev2_Cust =
			    CALCULATETABLE(
			        VALUES( 'fact_orders'[CustomerID] ),
			        DATEADD( SAMEPERIODLASTYEAR( 'dim_date'[Date] ), -2, YEAR )
			    )
			VAR ReturningPrev =
			    COUNTROWS(
			        INTERSECT(
			            PY_Prev2_Cust,
			            EXCEPT( PY_CurrCust, PY_Prev1_Cust )
			        )
			    )
			
			VAR Diff = ReturningCurr - ReturningPrev
			VAR DiffPct = DIVIDE( Diff, ReturningPrev )
			VAR Plus = IF( Diff > 0, "+", "" )
			
			RETURN
			    FORMAT( Diff, "#,##0" )
			        & "  |  "
			        & Plus & FORMAT( DiffPct, "0%" )
			        & " vs PY"
