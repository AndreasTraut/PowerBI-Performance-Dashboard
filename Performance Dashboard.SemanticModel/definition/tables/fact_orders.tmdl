	measure Customer_Retention_Rate = ```
			
			VAR CurrYearCustomers =
			    CALCULATETABLE(
			        VALUES('fact_orders'[CustomerID]),
			        ALL('dim_date'),
			        KEEPFILTERS('dim_date'),
			        VALUES('dim_date'[Year])   -- current slicer selection
			    )
			
			VAR PrevYearCustomers =
			    CALCULATETABLE(
			        VALUES('fact_orders'[CustomerID]),
			        DATEADD('dim_date'[Date], -1, YEAR)
			    )
			
			-- Customers who bought both last year AND this year
			VAR RetainedCustomers =
			    COUNTROWS(
			        INTERSECT(PrevYearCustomers, CurrYearCustomers)
			    )
			
			-- Total customers last year
			VAR TotalPrevYearCustomers =
			    COUNTROWS(PrevYearCustomers)
			
			RETURN
			    DIVIDE(RetainedCustomers, TotalPrevYearCustomers)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2e0ba392-f771-4ecd-9249-ba47918f0524

	measure Customer_Retention_YoY_Color =
			
			VAR CurrCust = VALUES('fact_orders'[CustomerID])
			VAR PrevCust =
			    CALCULATETABLE(
			        VALUES('fact_orders'[CustomerID]),
