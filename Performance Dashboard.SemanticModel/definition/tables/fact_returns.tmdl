	measure ReturnedOrderAmount_Detail =
			VAR Curr =
			    [ReturnedOrderAmount]
			
			VAR PrevYear =
			    CALCULATE(
			        [ReturnedOrderAmount],
			        SAMEPERIODLASTYEAR('dim_date'[Date])
			    )
			
			VAR Diff = Curr - PrevYear
			VAR DiffPct = DIVIDE(Diff, PrevYear)
			
			-- Display amount in K
			VAR DiffK = DIVIDE(ABS(Diff), 1000)
			
			VAR PlusSign = IF(DiffPct > 0, "+", "")
			
			-- Determine sign for currency
			VAR SignAmt = IF(Diff < 0, "- ", "")
			
			RETURN
			SignAmt & "$" & FORMAT(DiffK, "#,0") & "K | "
			    & PlusSign & FORMAT(DiffPct, "0.0%") & " vs PY"
		lineageTag: 82298bfd-6f2e-4419-b935-9b1724793529

