	measure Customer_MoM_Diff =
			VAR Curr = [number_of_customers]
			VAR Prev =
			    CALCULATE (
			        [number_of_customers],
			        SAMEPERIODLASTYEAR ( 'dim_date'[Date] )
			    )
			
			VAR Diff = Curr - Prev
			VAR DiffPct = DIVIDE ( Diff, Prev )
			
			-- Only add + if positive, otherwise nothing
			VAR PlusSymbol = IF ( Diff > 0, "+", "" )
			
			RETURN
			    -- Diff shows negative automatically if < 0
			    FORMAT ( Diff, "#,##0" )
			        & "  |  "
			        & PlusSymbol & FORMAT ( DiffPct, "0%" )
			        & " vs PY"
		lineageTag: 951849d2-9465-4317-b570-b94e6303c372

	measure Customer_MoM_Color =
