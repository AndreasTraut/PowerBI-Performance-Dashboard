table fact_sales
	lineageTag: ccb692f1-5575-4741-a555-57fc8e4babdf

	measure percentage_diff_prv_year_sales = ```
			
			VAR curr_year =
			    YEAR ( MAX ( 'fact_sales'[SalesDate] ) )
			
			VAR curr_year_sales =
			    CALCULATE (
			        SUM ( 'fact_sales'[NetSales] ),
			        YEAR ( 'fact_sales'[SalesDate] ) = curr_year
			    )
			
			VAR prev_year_sales =
			    CALCULATE (
			        SUM ( 'fact_sales'[NetSales] ),
			        DATEADD('dim_date'[Date],-1,YEAR)
			    )
			
			VAR pct_change =
			    DIVIDE ( curr_year_sales - prev_year_sales, prev_year_sales )
			
			VAR sign =
			    IF ( pct_change > 0, "+", "" )   -- negative already has "-" automatically
			
			RETURN
			sign & FORMAT( pct_change, "0.0%" )
			
			```
		lineageTag: ead0e184-77be-4a9f-ae5f-99b5c36cb712

	measure curr_year_sales =
			VAR curr_year = Year(MAX('fact_sales'[SalesDate]))
			var curr_year_sales = CALCULATE(
			    SUM(
			        'fact_sales'[NetSales]),
			        YEAR('fact_sales'[SalesDate]) = curr_year
			)
			
			var prev_year_sales = CALCULATE(
			    SUM(
			        'fact_sales'[NetSales]),
			        YEAR('fact_sales'[SalesDate]) = curr_year -1
			)
			
			RETURN
			curr_year_sales
		lineageTag: eb4bb721-2ed6-4b46-a2af-75a2245676b9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure prev_year_sales =
			VAR curr_year = Year(MAX('fact_sales'[SalesDate]))
			var curr_year_sales = CALCULATE(
			    SUM(
			        'fact_sales'[NetSales]),
			        YEAR('fact_sales'[SalesDate]) = curr_year
			)
			
			var prev_year_sales = CALCULATE(
			    SUM(
			        'fact_sales'[NetSales]),
			       DATEADD('dim_date'[Date],-1,YEAR)
			)
			
			RETURN
			prev_year_sales
		lineageTag: 9eb626a7-0eb1-4ecc-b04c-9ff81b70024a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

