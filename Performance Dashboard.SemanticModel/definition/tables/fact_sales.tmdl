	measure label_b2c = ```
			VAR BaseSalesB2C = 
			    CALCULATE(
			        SUM('fact_sales'[NetSales]),
			        'dim_channel'[ChannelName (3)] = "B2C"
			    )
			
			VAR TotalSales = SUM('fact_sales'[NetSales])
			
			-- STEP 1: Explicitly convert the sales amount to millions (e.g., 25,750,000 becomes 25.75)
			VAR SalesB2CInMillions = 
			    DIVIDE(BaseSalesB2C, 1000000)
			
			-- STEP 2: Format the millions value with a dollar sign, two decimals, and the 'M' suffix
			VAR SalesB2CFormatted = 
			    FORMAT(
			        SalesB2CInMillions,
			        "$ 0.0 M" -- The format "0.00" ensures two decimal places.
			    )
			
			-- STEP 3: Calculate the percentage (e.g., 0.2575)
			VAR PercentageB2C = 
			    DIVIDE(
			        BaseSalesB2C,
			        TotalSales
			    )
			
			-- STEP 4: Format the percentage value with two decimal places (e.g., 25.75 %)
			VAR PercentageB2CFormatted = 
			    FORMAT(
			        PercentageB2C,
			        "0 %" -- The format "0.00 %" ensures two decimal places for the percentage.
			    )
			
			RETURN 
			    -- Concatenate all parts into the final string
			    SalesB2CFormatted & " (" & PercentageB2CFormatted & ")"
			```
		lineageTag: 8450d139-e76b-4010-ae0e-62f241fd4d5b

	measure label_b2b = ```
			
			VAR BaseSalesB2B = 
			    CALCULATE(
			        SUM('fact_sales'[NetSales]),
			        -- Filter changed to B2B
			        'dim_channel'[ChannelName (3)] = "B2B" 
			    )
			
			VAR TotalSales = SUM('fact_sales'[NetSales])
			
			-- STEP 1: Explicitly convert the sales amount to millions 
			VAR SalesB2BInMillions = 
			    DIVIDE(BaseSalesB2B, 1000000)
			
			-- STEP 2: Format the millions value with a dollar sign, two decimals, and the 'M' suffix
			VAR SalesB2BFormatted = 
			    FORMAT(
			        SalesB2BInMillions,
			        "$ 0.0 M"
			    )
			
			-- STEP 3: Calculate the percentage 
			VAR PercentageB2B = 
			    DIVIDE(
			        BaseSalesB2B,
			        TotalSales
			    )
			
			-- STEP 4: Format the percentage value with two decimal places
			VAR PercentageB2BFormatted = 
			    FORMAT(
			        PercentageB2B,
			        "0 %"
			    )
			
			RETURN 
			    -- Concatenate all parts into the final string
			    SalesB2BFormatted & " (" & PercentageB2BFormatted & ")"
			```
		lineageTag: 9a36f171-b070-4927-9247-91ede0a060cd

	measure NetSales_YoY_Diff =
			
			VAR CurrSales = SUM ( 'fact_sales'[NetSales] )
			VAR PrevYearSales =
			    CALCULATE (
			        SUM ( 'fact_sales'[NetSales] ),
			        SAMEPERIODLASTYEAR ( 'dim_date'[Date] )
			    )
			
			VAR SalesDiff = CurrSales - PrevYearSales
			VAR SalesDiffPct = DIVIDE ( SalesDiff, PrevYearSales )
			
			-- Only add + symbol if the difference is positive
			VAR PlusSymbol = IF ( SalesDiff > 0, "+", "" )
			
			RETURN
			    -- Format the absolute difference (e.g., -$1,500 or +$5,000)
			    FORMAT ( SalesDiff, "$#,##0" )
			        & "  |  "
			        -- Format the percentage difference (e.g., +15% vs PY)
			        & PlusSymbol & FORMAT ( SalesDiffPct, "0%" )
			        & " vs PY"
		lineageTag: 41699488-78d5-4fb0-90d1-bae3640e195e

	measure NetSales_YOY_Arrow = ```
			
			VAR CurrSales = SUM ( 'fact_sales'[NetSales] )
			VAR PrevMonthSales =
			    CALCULATE (
			        SUM ( 'fact_sales'[NetSales] ),
			        DATEADD ( 'dim_date'[Date], -1, Year )
			    )
			VAR SalesDiff = CurrSales - PrevMonthSales
			RETURN 
			    IF ( 
			        SalesDiff > 0, 
			        "▲",
			        IF ( 
			            SalesDiff < 0, 
			            "▼",
			            "▪"
			        )
			    )
			```
		lineageTag: efa3aa55-770f-4810-bb7a-050d8b99ce12

	measure NetSales_YoY_Color = ```
			
			VAR CurrSales = SUM ( 'fact_sales'[NetSales] )
			VAR PrevYearSales =
			    CALCULATE (
			        SUM ( 'fact_sales'[NetSales] ),
			        SAMEPERIODLASTYEAR ( 'dim_date'[Date] )
			    )
			VAR SalesDiff = CurrSales - PrevYearSales
			RETURN 
