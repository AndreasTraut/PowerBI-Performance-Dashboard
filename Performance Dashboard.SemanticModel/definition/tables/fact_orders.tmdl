	measure 'Order Amount Difference Text' =
			
			VAR CurrentSales = SUM(fact_orders[orderamount])
			VAR PriorSales =
			    CALCULATE(
			        SUM(fact_orders[orderamount]),
			        SAMEPERIODLASTYEAR('dim_date'[date])
			    )
			VAR SalesDifference = CurrentSales - PriorSales
			
			RETURN
			    FORMAT(
			        SalesDifference,
			        "+$#,##0;-$#,##0;$#,##0"
			    )
		lineageTag: 7c3adda2-2e66-4277-8b7d-5c97996f7989

