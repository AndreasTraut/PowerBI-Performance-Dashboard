	column Order_Value_Category_Col = ```
			
			SWITCH(
			    TRUE(),
			    'fact_orders'[OrderAmount] < 50, "Very Low",
			    'fact_orders'[OrderAmount] >= 50 && 'fact_orders'[OrderAmount] < 100, "Low",
			    'fact_orders'[OrderAmount] >= 100 && 'fact_orders'[OrderAmount] < 250, "Medium-Low",
			    'fact_orders'[OrderAmount] >= 250 && 'fact_orders'[OrderAmount] < 500, "Medium",
			    'fact_orders'[OrderAmount] >= 500 && 'fact_orders'[OrderAmount] < 1000, "Medium-High",
			    'fact_orders'[OrderAmount] >= 1000 && 'fact_orders'[OrderAmount] < 2000, "High",
			    'fact_orders'[OrderAmount] >= 2000 && 'fact_orders'[OrderAmount] < 5000, "Very High",
