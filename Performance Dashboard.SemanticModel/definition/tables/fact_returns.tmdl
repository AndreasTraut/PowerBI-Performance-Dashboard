table fact_returns
	lineageTag: 6b9642b8-3cd0-4fc5-891c-48dbd133a14f

	measure number_of_returns = DISTINCTCOUNT('fact_returns'[ReturnID])
		formatString: #,0
		lineageTag: e3a26be9-6048-4a2f-a595-f102083ea7b8

	measure percentage_diff_prv_year_returns = ```
			
			VAR curr_year =
			    YEAR ( MAX ( 'fact_returns'[ReturnDate] ) )
			
			VAR curr_year_orders =
			    CALCULATE (
			        [number_of_returns],
			        YEAR ( 'fact_returns'[ReturnDate] ) = curr_year
			    )
			
			VAR prev_year_orders =
			    CALCULATE (
			        [number_of_returns],
			        DATEADD('dim_date'[Date],-1,YEAR)
			    )
			
			
			VAR pct_change =
			    DIVIDE ( curr_year_orders - prev_year_orders, prev_year_orders )
			
			VAR sign =
			    IF ( pct_change > 0, "+", "" )   -- negative already has "-" automatically
			
			RETURN
			sign & FORMAT( pct_change, "0.00%" )
			
			```
		lineageTag: f5e7f54b-44ab-4646-a506-328f7928421b

	measure curr_year_returns =
			VAR curr_year = Year(MAX('fact_returns'[ReturnDate]))
			var curr_year_ORDERS = CALCULATE(
			    [number_of_returns],
			        YEAR('fact_returns'[ReturnDate]) = curr_year
			)
			
			var prev_year_ORDERS = CALCULATE(
			    [number_of_returns],
			        YEAR('fact_returns'[ReturnDate]) = curr_year-1
			)
			
			RETURN
			curr_year_ORDERS
		formatString: 0
		lineageTag: f47aec25-3269-4709-a076-fb01d0fc7726

	measure prev_year_returns =
			VAR curr_year = Year(MAX('fact_returns'[ReturnDate]))
			var curr_year_ORDERS = CALCULATE(
