	measure 'Customer Churn Rate (%)' = ```
			
			VAR CurrYearCustomers =
			    CALCULATETABLE(
			        VALUES('fact_orders'[CustomerID]),
			        ALL('dim_date'),
			        KEEPFILTERS('dim_date'),
			        VALUES('dim_date'[Year])     -- current slicer selection
			    )
			
			VAR PrevYearCustomers =
			    CALCULATETABLE(
			        VALUES('fact_orders'[CustomerID]),
			        DATEADD('dim_date'[Date], -1, YEAR)
			    )
			
			VAR LostCustomers =
			    COUNTROWS(
			        EXCEPT(PrevYearCustomers, CurrYearCustomers)
			    )
			
			VAR StartOfYearCustomers =
			    COUNTROWS(PrevYearCustomers)
			
			RETURN
			    DIVIDE(LostCustomers, StartOfYearCustomers)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2fc6af54-1828-4061-b37a-b934d4c9848e

	measure 'Returning Customers' =
			
			---------------------------------------------
			-- Customers in current period
			---------------------------------------------
			VAR CurrCust =
			    VALUES ( 'fact_orders'[CustomerID] )
			
			-- Customers in prior period (e.g., last year)
			VAR Prev1_Cust =
			    CALCULATETABLE (
			        VALUES ( 'fact_orders'[CustomerID] ),
			        DATEADD ( 'dim_date'[Date], -1, YEAR )
			    )
			
			-- Customers in prior-2 period (two years ago)
			VAR Prev2_Cust =
			    CALCULATETABLE (
			        VALUES ( 'fact_orders'[CustomerID] ),
			        DATEADD ( 'dim_date'[Date], -2, YEAR )
			    )
			
			---------------------------------------------
			-- Returning customers = bought 2 years ago,
			-- skipped last year, bought this period
			---------------------------------------------
			VAR ReturningCust =
			    INTERSECT (
			        Prev2_Cust,              -- bought 2 years ago
			        EXCEPT ( CurrCust, Prev1_Cust )  -- bought this period but NOT last period
			    )
			
			RETURN
			    COUNTROWS ( ReturningCust )
		formatString: 0
		lineageTag: 2493a391-adf1-46cd-9065-19060948acbf

	measure 'New Customers' = ```
			
			VAR CurrYear =
			    SELECTEDVALUE ( 'dim_date'[Year] )
			
			VAR PrevYear =
			    CurrYear - 1
			
			-- Customers who bought in previous year
			VAR Cust_PrevYear =
			    CALCULATETABLE (
			        VALUES ( 'fact_orders'[CustomerID] ),
			        'dim_date'[Year] = PrevYear
			    )
			
			-- Customers who bought in current year
			VAR Cust_CurrYear =
			    CALCULATETABLE (
			        VALUES ( 'fact_orders'[CustomerID] ),
			        'dim_date'[Year] = CurrYear
			    )
			
			-- New customers = customers in current year
			-- who were NOT customers in previous year
			VAR NewCust =
			    EXCEPT ( Cust_CurrYear, Cust_PrevYear )
			
			RETURN
			    COUNTROWS ( NewCust )
			
			```
		formatString: #,0
		lineageTag: 0bf12359-53d8-4057-98e7-b64e3af611f6

	measure avg_revenue_per_customer = SUM('fact_orders'[OrderAmount]) / [number_of_customers]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
