	partition dim_date = calculated
		mode: import
		source = ```
				
				VAR MinDate =
				    CALCULATE ( MIN ( 'fact_sales'[SalesDate] ), ALL ( 'fact_sales' ) )
				
				VAR MaxDate =
				    CALCULATE ( MAX ( 'fact_sales'[SalesDate] ), ALL ( 'fact_sales' ) )
				
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( MinDate, MaxDate ),
				    "Year", YEAR ( [Date] ),
				    "Year Month", FORMAT ( [Date], "YYYY-MM" ),
				    "Month Number", MONTH ( [Date] ),
				    "Month Name", FORMAT ( [Date], "MMMM" ),
				    "Short Month", FORMAT ( [Date], "MMM" ),
				    "Quarter", "Q" & FORMAT ( [Date], "Q" ),
				    "Year Quarter", FORMAT ( [Date], "YYYY" ) & "-Q" & FORMAT ( [Date], "Q" ),
				    "Week Number", WEEKNUM ( [Date], 2 ),
				    "Day", DAY ( [Date] ),
				    "Day Name", FORMAT ( [Date], "DDDD" ),
				    "Short Day", FORMAT ( [Date], "DDD" ),
				    "Is Weekend", IF ( WEEKDAY ( [Date], 2 ) > 5, TRUE(), FALSE() ),
				    "Start of Month", EOMONTH ( [Date], -1 ) + 1,
				    "End of Month", EOMONTH ( [Date], 0 ),
				    "Start of Quarter",
				        DATE ( YEAR ( [Date] ), ( ( QUARTER ( [Date] ) - 1 ) * 3 ) + 1, 1 ),
				    "End of Quarter",
				        EOMONTH ( DATE ( YEAR ( [Date] ), ( ( QUARTER ( [Date] ) - 1 ) * 3 ) + 3, 1 ), 0 ),
				    "Start of Year", DATE ( YEAR ( [Date] ), 1, 1 ),
				    "End of Year", DATE ( YEAR ( [Date] ), 12, 31 )
				)
				
				```

	annotation PBI_Id = 4ab66b9dbf2149879de431f817c09d00

