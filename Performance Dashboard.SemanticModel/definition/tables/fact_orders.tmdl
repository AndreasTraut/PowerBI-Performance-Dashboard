	measure Avg_Order_Value_YoY_Diff =
			
			VAR CurrAOV =
			    DIVIDE(
			        SUM('fact_sales'[NetSales]),
			        DISTINCTCOUNT('fact_orders'[OrderID])
			    )
			
			VAR PrevAOV =
			    CALCULATE(
			        DIVIDE(
			            SUM('fact_sales'[NetSales]),
			            DISTINCTCOUNT('fact_orders'[OrderID])
			        ),
			        SAMEPERIODLASTYEAR('dim_date'[Date])
			    )
			
			VAR Diff = CurrAOV - PrevAOV
			VAR DiffPct = DIVIDE(Diff, PrevAOV)
			
			-- Detect if negative
			VAR SignAmt = IF(Diff < 0, "-", "")
			
			-- Absolute amount for formatting
			VAR AbsDiff = ABS(Diff)
			
			VAR PlusPct = IF(DiffPct > 0, "+", "")
			
			RETURN
			SignAmt & "$" & FORMAT(AbsDiff, "#,##0.00")
			    & " | "
			    & PlusPct & FORMAT(DiffPct, "0%")
			    & " vs PY"
		lineageTag: 6d643856-0e73-4fb2-893b-c0714d19da6a

	measure Completed_Orders_YoY_Diff =
			VAR CurrCompleted =
			    CALCULATE(
			        DISTINCTCOUNT('fact_orders'[OrderID]),
			        'fact_orders'[OrderStatus] = "Delivered"
			    )
			
			VAR CurrTotal =
			    DISTINCTCOUNT('fact_orders'[OrderID])
			
			VAR CurrPct =
			    DIVIDE(CurrCompleted, CurrTotal)
			
			VAR PrevCompleted =
			    CALCULATE(
			        DISTINCTCOUNT('fact_orders'[OrderID]),
			        'fact_orders'[OrderStatus] = "Delivered",
			        SAMEPERIODLASTYEAR('dim_date'[Date])
			    )
			
			VAR PrevTotal =
			    CALCULATE(
			        DISTINCTCOUNT('fact_orders'[OrderID]),
			        SAMEPERIODLASTYEAR('dim_date'[Date])
			    )
			
			VAR PrevPct =
			    DIVIDE(PrevCompleted, PrevTotal)
			
			VAR Diff = CurrPct - PrevPct
			
			RETURN
			FORMAT(Diff, "0.00%") & " vs PY"
		lineageTag: b19b0750-418f-4f14-96e6-4bc9653dc912

	measure Completed_Orders_YoY_Color =
			
			---------------------------------------------
			-- Current period
			---------------------------------------------
			VAR CurrCompleted = CALCULATE(
			    DISTINCTCOUNT('fact_orders'[OrderID]),
			    'fact_orders'[OrderStatus] = "Delivered"
			)
			VAR CurrTotal = DISTINCTCOUNT('fact_orders'[OrderID])
			VAR CurrPct = DIVIDE(CurrCompleted, CurrTotal)
			
			---------------------------------------------
			-- Previous year's equivalent period
			---------------------------------------------
			VAR PrevCompleted = CALCULATE(
			    DISTINCTCOUNT('fact_orders'[OrderID]),
			    'fact_orders'[OrderStatus] = "Delivered",
			    SAMEPERIODLASTYEAR('dim_date'[Date])
			)
			VAR PrevTotal = CALCULATE(
			    DISTINCTCOUNT('fact_orders'[OrderID]),
			    SAMEPERIODLASTYEAR('dim_date'[Date])
			)
			VAR PrevPct = DIVIDE(PrevCompleted, PrevTotal)
			
			---------------------------------------------
			-- Return Color
			---------------------------------------------
			RETURN
			IF(CurrPct > PrevPct, "Green", "Red")
		lineageTag: aa14bd88-bc12-43d2-9fda-3ba89d5eda99

