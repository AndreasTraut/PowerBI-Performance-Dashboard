	measure New_Customers_MoM_Arrow = ```
			
			VAR CurrentCustomers =
			    VALUES ( 'fact_orders'[CustomerID] )
			
			VAR PriorCustomers =
			    CALCULATETABLE (
			        VALUES ( 'fact_orders'[CustomerID] ),
			        DATEADD ( 'dim_date'[Date], -1, YEAR )
			    )
			
			VAR NewCurr =
			    COUNTROWS ( EXCEPT ( CurrentCustomers, PriorCustomers ) )
			
			VAR PrevPeriodCustomers =
			    CALCULATETABLE (
			        VALUES ( 'fact_orders'[CustomerID] ),
			        SAMEPERIODLASTYEAR ( 'dim_date'[Date] )
			    )
			
			VAR PrevPeriodCustomers_Prior =
			    CALCULATETABLE (
			        VALUES ( 'fact_orders'[CustomerID] ),
			        DATEADD ( SAMEPERIODLASTYEAR ( 'dim_date'[Date] ), -1, YEAR )
			    )
			
			VAR NewPrev =
			    COUNTROWS ( EXCEPT ( PrevPeriodCustomers, PrevPeriodCustomers_Prior ) )
			
			VAR Diff = NewCurr - NewPrev
			RETURN
			IF( Diff > 0, "▲", "▼" )
			
			```
		lineageTag: 85009c96-c78d-4fcb-9fe7-c79bea1dea5d

	measure Returning_Customers_MoM_Arrow = ```
			
			VAR CurrCust = VALUES( 'fact_orders'[CustomerID] )
			VAR Prev1_Cust =
			    CALCULATETABLE(
			        VALUES( 'fact_orders'[CustomerID] ),
			        DATEADD( 'dim_date'[Date], -1, YEAR )
			    )
			VAR Prev2_Cust =
			    CALCULATETABLE(
			        VALUES( 'fact_orders'[CustomerID] ),
			        DATEADD( 'dim_date'[Date], -2, YEAR )
			    )
			VAR ReturningCurr =
			    COUNTROWS(
			        INTERSECT(
			            Prev2_Cust,
			            EXCEPT( CurrCust, Prev1_Cust )
			        )
			    )
			
			VAR PY_CurrCust =
			    CALCULATETABLE(
			        VALUES( 'fact_orders'[CustomerID] ),
			        SAMEPERIODLASTYEAR( 'dim_date'[Date] )
			    )
			VAR PY_Prev1_Cust =
			    CALCULATETABLE(
			        VALUES( 'fact_orders'[CustomerID] ),
			        DATEADD( SAMEPERIODLASTYEAR( 'dim_date'[Date] ), -1, YEAR )
			    )
			VAR PY_Prev2_Cust =
			    CALCULATETABLE(
			        VALUES( 'fact_orders'[CustomerID] ),
			        DATEADD( SAMEPERIODLASTYEAR( 'dim_date'[Date] ), -2, YEAR )
			    )
			VAR ReturningPrev =
			    COUNTROWS(
			        INTERSECT(
			            PY_Prev2_Cust,
			            EXCEPT( PY_CurrCust, PY_Prev1_Cust )
			        )
			    )
			
			VAR Diff = ReturningCurr - ReturningPrev
			RETURN IF( Diff > 0, "▲", "▼" )
			
			```
		lineageTag: 49b089cf-6a8c-480b-a459-dc7040562be1

	measure Customer_Churn_MoM_Arrow = ```
			
			VAR CurrCust = VALUES('fact_orders'[CustomerID])
			VAR PrevCust =
			    CALCULATETABLE(
			        VALUES('fact_orders'[CustomerID]),
			        DATEADD('dim_date'[Date], -1, YEAR)
			    )
			VAR RetainedCurr = COUNTROWS(INTERSECT(CurrCust, PrevCust))
			VAR TotalPrevCust = COUNTROWS(PrevCust)
			VAR RetentionCurr = DIVIDE(RetainedCurr, TotalPrevCust)
			
			VAR PY_CurrCust =
			    CALCULATETABLE(
			        VALUES('fact_orders'[CustomerID]),
			        SAMEPERIODLASTYEAR('dim_date'[Date])
			    )
			VAR PY_PrevCust =
			    CALCULATETABLE(
			        VALUES('fact_orders'[CustomerID]),
			        DATEADD(SAMEPERIODLASTYEAR('dim_date'[Date]), -1, YEAR)
			    )
			VAR RetainedPrev = COUNTROWS(INTERSECT(PY_CurrCust, PY_PrevCust))
			VAR TotalPrevPrev = COUNTROWS(PY_PrevCust)
			VAR RetentionPrev = DIVIDE(RetainedPrev, TotalPrevPrev)
			
			VAR Diff = RetentionCurr - RetentionPrev
			RETURN IF(Diff > 0, "▲", "▼")
			
			```
		lineageTag: 56927776-970e-467e-899f-373b9e4ffe0b

