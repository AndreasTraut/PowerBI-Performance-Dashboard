	measure Returns_Detail_Measure =
			
			---------------------------------------------
			-- Current period
			---------------------------------------------
			VAR Curr =
			    [number_of_returns]
			
			---------------------------------------------
			-- Previous year (YoY)
			---------------------------------------------
			VAR PrevYear =
			    CALCULATE(
			        [number_of_returns],
			        SAMEPERIODLASTYEAR('dim_date'[Date])
			    )
			
			---------------------------------------------
			-- Differences
			---------------------------------------------
			VAR Diff = Curr - PrevYear
			VAR DiffPct = DIVIDE(Diff, PrevYear)
			
			VAR PlusSign = IF(DiffPct > 0, "+", "")
			
			RETURN
			FORMAT(Diff, "#,0")
			    & " | "
			    & PlusSign
			    & FORMAT(DiffPct, "0.0%")
			    & " vs PY"
		lineageTag: 6b3c2f8e-2f95-4258-80fb-00ed98f38492

	measure Returns_Arrow_Measure =
			
			VAR Curr =
			    [number_of_returns]
			
			VAR PrevYear =
			    CALCULATE(
