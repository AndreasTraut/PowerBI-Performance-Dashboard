	measure number_of_orders = DISTINCTCOUNT('fact_orders'[OrderID])
		formatString: #,0
		lineageTag: 577617f3-baf0-470a-a9ca-9a697de956ae

	measure curr_year_orders =
			VAR curr_year = Year(MAX('fact_orders'[OrderDate]))
			var curr_year_ORDERS = CALCULATE(
			    [number_of_orders],
			        YEAR('fact_orders'[OrderDate]) = curr_year
			)
			
			var prev_year_ORDERS = CALCULATE(
			    [number_of_orders],
			        YEAR('fact_orders'[OrderDate]) = curr_year-1
			)
			
			RETURN
			curr_year_ORDERS
		formatString: 0
		lineageTag: a4f23be6-2086-4fff-8a00-2cfe9b2f9433

	measure prev_year_orders =
			VAR curr_year = Year(MAX('fact_orders'[OrderDate]))
			var curr_year_ORDERS = CALCULATE(
			    [number_of_orders],
			        YEAR('fact_orders'[OrderDate]) = curr_year
			)
			
			var prev_year_ORDERS = CALCULATE(
			    [number_of_orders],
			        DATEADD('dim_date'[Date],-1,YEAR)
			)
			
			RETURN
			prev_year_ORDERS
		formatString: 0
		lineageTag: 0f886b68-e050-4665-a97e-ddcec50e908a

	measure 'orders YoY Change Text' = ```
			
			VAR OrdersCY = [curr_year_orders]      -- current year sales
			VAR OrdersPY = [prev_year_orders]      -- previous year sales
			VAR Change = DIVIDE(OrdersCY - OrdersPY, OrdersPY)
			VAR Sign = 
			    IF(Change >= 0, "+", "-")
			RETURN
			Sign & FORMAT( ABS(Change), "0.000" )
			```
		lineageTag: 72c7c2f7-a80d-4d72-86bb-8520fd609830

	measure percentage_diff_prv_year_orders = ```
			
			VAR curr_year =
			    YEAR ( MAX ( 'fact_orders'[OrderDate] ) )
			
			VAR curr_year_orders =
			    CALCULATE (
			        [number_of_orders],
			        YEAR ( 'fact_orders'[OrderDate] ) = curr_year
			    )
			
			VAR prev_year_orders =
			    CALCULATE (
			        [number_of_orders],
			        DATEADD('dim_date'[Date],-1,YEAR)
			    )
			
			VAR pct_change =
			    DIVIDE ( curr_year_orders - prev_year_orders, prev_year_orders )
			
			VAR sign =
			    IF ( pct_change > 0, "+", "" )   -- negative already has "-" automatically
			
			RETURN
			sign & FORMAT( pct_change, "0.00%" )
			
			```
		lineageTag: 171c51a2-dc0f-4c15-8709-0449e995cc46

