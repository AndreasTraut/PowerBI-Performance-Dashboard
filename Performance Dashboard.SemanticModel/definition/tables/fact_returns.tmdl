			)
			
			var prev_year_ORDERS = CALCULATE(
			    [number_of_returns],
			        DATEADD('dim_date'[Date],-1,YEAR)
			)
			
			RETURN
			prev_year_ORDERS
		formatString: 0
		lineageTag: b75f7959-cd19-48da-887b-da110204ac8b

