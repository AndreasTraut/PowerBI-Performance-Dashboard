			VAR Prev =
			    CALCULATE(
			        [number_of_customers],
			        SAMEPERIODLASTYEAR('dim_date'[Date])
			    )
			VAR Diff = Curr - Prev
			RETURN
			IF( Diff > 0, "#00B050", "#FF0000" )
		lineageTag: 5016d7e4-3621-4be2-a490-066cb6b414a5

	measure New_Customers_MoM_Diff =
			
			VAR CurrentCustomers =
			    VALUES ( 'fact_orders'[CustomerID] )
			
			VAR PriorCustomers =
			    CALCULATETABLE (
			        VALUES ( 'fact_orders'[CustomerID] ),
			        DATEADD ( 'dim_date'[Date], -1, YEAR )
			    )
			
			VAR NewCurr =
			    COUNTROWS ( EXCEPT ( CurrentCustomers, PriorCustomers ) )
			
			VAR PrevPeriodCustomers =
			    CALCULATETABLE (
			        VALUES ( 'fact_orders'[CustomerID] ),
			        SAMEPERIODLASTYEAR ( 'dim_date'[Date] )
			    )
			
			VAR PrevPeriodCustomers_Prior =
			    CALCULATETABLE (
			        VALUES ( 'fact_orders'[CustomerID] ),
			        DATEADD ( SAMEPERIODLASTYEAR ( 'dim_date'[Date] ), -1, YEAR )
			    )
			
			VAR NewPrev =
			    COUNTROWS ( EXCEPT ( PrevPeriodCustomers, PrevPeriodCustomers_Prior ) )
			
			VAR Diff = NewCurr - NewPrev
			VAR DiffPct = DIVIDE( Diff, NewPrev )
			
			VAR Plus = IF( Diff > 0, "+", "" )
			
			RETURN
			    FORMAT( Diff, "#,##0" )
			        & "  |  "
			        & Plus & FORMAT( DiffPct, "0%" )
			        & " vs PY"
		lineageTag: d7d06170-3009-46d9-8c9e-c509505150f7

